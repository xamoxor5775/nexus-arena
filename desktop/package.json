{
  "name": "nexus-arena-desktop",
  "productName": "Nexus Arena",
  "version": "0.1.0",
  "private": true,
  "description": "Nexus Arena - offline desktop edition",
  "author": "Nexus Arena",
  "license": "UNLICENSED",
  "main": "main.cjs",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "prepare:game": "node scripts/prepare.mjs",
    "build": "npm run prepare:game && vite build --config vite.config.mjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/desktop.test.cjs",
    "smoke": "electron . --smoke-test --use-angle=swiftshader --enable-unsafe-swiftshader",
    "dist:win": "npm run test && npm run build && electron-builder --win nsis zip --x64 --publish never",
    "pack:win": "npm run test && npm run build && electron-builder --win --x64 --dir --publish never"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "^26.0.12",
    "lucide-react": "0.510.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwindcss": "4.3.0",
    "three": "0.186.0",
    "vite": "8.2.0",
    "zustand": "5.0.0"
  },
  "build": {
    "appId": "com.nexusarena.desktop",
    "productName": "Nexus Arena",
    "asar": true,
    "npmRebuild": false,
    "directories": { "output": "release" },
    "files": ["dist/**/*", "main.cjs", "preload.cjs", "runtime.cjs", "smoke.cjs", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "zip", "arch": ["x64"] }],
      "artifactName": "Nexus-Arena-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
