# Optional: use PostgreSQL/Neon for persistent production data.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Flow Chile. Keep the keys only in the server's .env file.
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_API_URL=https://www.flow.cl/api
# CLP equivalent of the advertised US$1 access price.
FLOW_AMOUNT_CLP=1000
FLOW_PAYMENT_METHOD=9

# Public URL used by Flow callbacks and returns.
NEXUS_PUBLIC_URL=http://23.23.152.63:8080
NEXUS_ACCESS_SECRET=replace-with-a-long-random-secret
NEXUS_ADMIN_SECRET=replace-with-a-separate-admin-password
NEXUS_COOKIE_SECURE=false

# Append-only debug spool. In Docker it lives in the persistent data volume.
# NEXUS_SPOOL_PATH=/app/data/nexus-arena.spool

# Google Ads. Public tag IDs (they appear in the browser). Restart the container after filling them.
# GOOGLE_ADS_ID=AW-XXXXXXXXX
# GOOGLE_ADS_PURCHASE_LABEL=
# GOOGLE_ADS_CHECKOUT_LABEL=

# Sala de desarrollo fija ("SALA 1 · DEV"). Lista de ids de sesión de acceso
# (la parte <id> de una llave session.<id>.<ts>.<nonce>.<firma>), separados por coma.
# Esos testers siempre entran juntos a NEXUS_DEV_ROOM, sin tope ni desborde; nadie
# más puede entrar a esa sala. Vacío = desactivado. Nunca subir ids reales a Git.
# NEXUS_DEV_SESSIONS=
# NEXUS_DEV_ROOM=nexus-dev-1
# Arena que juegan todos en la sala dev (siempre deathmatch). Por defecto pozo;
# valores desconocidos vuelven a pozo.
# NEXUS_DEV_ARENA=pozo
